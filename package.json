{
  "name": "dsh-mcp-hub",
  "version": "0.1.0",
  "description": "DSH 的 MCP 管理面板与本机配置导入插件",
  "type": "module",
  "license": "MIT",
  "main": "src/host/index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol"
  ],
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host",
    "src/shared",
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "!docs/CODE_REVIEW*",
    "LICENSE",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "node scripts/build.mjs",
    "test:e2e": "node tests/e2e/web-profile.e2e.mjs",
    "test:registry": "node tests/e2e/registry.e2e.mjs",
    "test:oauth": "node tests/e2e/oauth.e2e.mjs",
    "test:ui": "node tests/e2e/ui-page.e2e.mjs",
    "test:layout": "node tests/e2e/ui-layout.e2e.mjs",
    "test:simulated": "node tests/e2e/simulated-sources.e2e.mjs",
    "test:tarball": "node tests/e2e/tarball.e2e.mjs",
    "test:remote": "node tests/e2e/real-remote.e2e.mjs",
    "test:real-sources": "node tests/e2e/real-sources.e2e.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^24.43.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0-0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-hanlu/dsh-mcp-hub.git"
  },
  "homepage": "https://github.com/mr-hanlu/dsh-mcp-hub#readme",
  "bugs": {
    "url": "https://github.com/mr-hanlu/dsh-mcp-hub/issues"
  }
}
